diff --git a/src/llm/systemOne.ts b/src/llm/systemOne.ts
new file mode 100644
--- /dev/null
+++ b/src/llm/systemOne.ts
@@ -0,0 +1,56 @@
+/** Optional shadow advice. Test status, existing assessment and notification gates stay authoritative. */
+import type { RunReport, SystemOneAdvice } from '../report/model.js';
+import type { SiteProfile } from '../sites/types.js';
+
+export function redactSystemOne(value: string): string {
+  return value.replace(/\u001b\[[0-9;]*m/g, '')
+    .replace(/[\w.+-]+@[\w.-]+\.[A-Za-z]{2,}/g, '[email]')
+    .replace(/(bearer\s+)[^\s"']+/gi, '$1[redacted]')
+    .replace(/((?:password|secret|api[_-]?key|access[_-]?token|token)\s*[=:]\s*)[^\s,;]+/gi, '$1[redacted]')
+    .replace(/[A-Za-z0-9_+/=-]{32,}/g, '[redacted-long-value]').slice(0, 550);
+}
+
+export async function systemOneAdvice(report: RunReport, profile: SiteProfile): Promise<SystemOneAdvice[] | undefined> {
+  const base = process.env.QA_LAYA_URL;
+  const key = process.env.QA_LAYA_API_KEY;
+  if (!base || !key || report.status === 'PASS') return undefined;
+  const output: SystemOneAdvice[] = [];
+  try {
+    const url = new URL(base);
+    if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password || url.search || url.hash) return undefined;
+    const model = process.env.QA_LAYA_MODEL ?? 'english';
+    if (!['auto', 'english', 'multilingual', 'typed-decisions'].includes(model)) return undefined;
+    const seconds = Number(process.env.QA_LAYA_TIMEOUT_SECONDS ?? '2');
+    if (!Number.isFinite(seconds) || seconds <= 0 || seconds > 5) return undefined;
+    for (const test of report.tests.filter(t => ['failed', 'timedOut', 'interrupted'].includes(t.outcome)).slice(0, 8)) {
+      const investigation = report.investigations?.find(i => i.specId === test.specId && i.project === test.project);
+      let contract = profile.signupGrantsTrial
+        ? 'Email verification grants an automatic trial.'
+        : 'A fresh verified account without entitlement has no automatic trial.';
+      if (profile.name === 'ghostshield' && !profile.signupGrantsTrial) contract += ' Trial activation requires a credit card.';
+      contract += ' App sign-out must revoke app tokens. Timeouts alone do not prove a product defect.';
+      const state = { site: report.site, test: redactSystemOne(test.title), trusted_contract: contract,
+        observed_error: redactSystemOne(test.errors.join(' ')), evidence: redactSystemOne(investigation?.evidence.join(' ') ?? '') };
+      const response = await fetch(base.replace(/\/$/, '') + '/api/v1/workflows/qa_cause', {
+        method: 'POST', redirect: 'error', signal: AbortSignal.timeout(seconds * 1000),
+        headers: { Authorization: `Bearer ${key}`, 'Content-Type': 'application/json' },
+        body: JSON.stringify({ state, model, min_confidence: 0.8 }),
+      });
+      if (!response.ok) break;
+      const text = await response.text();
+      if (text.length > 65536) break;
+      const data = JSON.parse(text);
+      const advice = data.advice;
+      if (advice?.advisory_only !== true || advice.authorization !== false || advice.workflow !== 'qa_cause'
+          || !['PRODUCT_BUG', 'TEST_BUG', 'INFRA', 'UNKNOWN'].includes(advice.label)
+          || typeof advice.answer_confidence !== 'number' || !Number.isFinite(advice.answer_confidence)
+          || advice.answer_confidence < 0 || advice.answer_confidence > 1 || typeof advice.review_required !== 'boolean'
+          || data.runtime?.device !== 'cuda:0' || typeof data.runtime?.revision !== 'string'
+          || !['english', 'multilingual', 'typed-decisions'].includes(data.routing?.model)) break;
+      output.push({ specId: test.specId ?? '', project: test.project, label: advice.label,
+        answerConfidence: advice.answer_confidence, reviewRequired: advice.review_required,
+        checkpoint: data.routing.model, revision: data.runtime.revision, advisoryOnly: true, authorization: false });
+    }
+  } catch { /* Best effort; an unavailable classifier must not fail a QA run. */ }
+  return output.length ? output : undefined;
+}
diff --git a/src/llm/systemOne.test.ts b/src/llm/systemOne.test.ts
