+++ b/src/llm/systemOne.test.ts
@@ -0,0 +1,50 @@
+import { test, afterEach } from 'node:test';
+import assert from 'node:assert/strict';
+import { systemOneAdvice, redactSystemOne } from './systemOne.js';
+import { ghostshield } from '../sites/ghostshield.js';
+import type { RunReport } from '../report/model.js';
+
+const originalFetch = globalThis.fetch;
+afterEach(() => {
+  globalThis.fetch = originalFetch;
+  for (const key of ['QA_LAYA_URL', 'QA_LAYA_API_KEY', 'QA_LAYA_MODEL']) delete process.env[key];
+});
+const report = { site: 'ghostshield', status: 'FAIL', tests: [{ specId: 'GS-018', title: 'trial',
+  project: 'desktop', outcome: 'failed', errors: ['expected trial, received paywall'] }] } as RunReport;
+
+test('new GhostShield contract requires explicit trial activation', () => {
+  assert.equal(ghostshield.signupGrantsTrial, false);
+});
+test('disabled adapter makes no network call', async () => {
+  globalThis.fetch = async () => { throw new Error('must not call'); };
+  assert.equal(await systemOneAdvice(report, ghostshield), undefined);
+});
+test('advice is projected without mutating test status or sending assessment labels', async () => {
+  process.env.QA_LAYA_URL = 'http://localhost:8000'; process.env.QA_LAYA_API_KEY = 'test-only';
+  const before = JSON.stringify(report);
+  globalThis.fetch = async (_url, options) => {
+    const body = String(options?.body);
+    assert.ok(body.includes('requires a credit card'));
+    assert.ok(!body.includes('classification'));
+    assert.equal(options?.redirect, 'error');
+    return new Response(JSON.stringify({ advice: { label: 'TEST_BUG', workflow: 'qa_cause', answer_confidence: .9,
+      review_required: false, advisory_only: true, authorization: false },
+      runtime: { device: 'cuda:0', revision: 'test' }, routing: { model: 'english' } }));
+  };
+  const hints = await systemOneAdvice(report, ghostshield);
+  assert.equal(hints?.[0]?.label, 'TEST_BUG');
+  assert.equal(hints?.[0]?.authorization, false);
+  assert.equal(JSON.stringify(report), before);
+});
+test('CPU or invalid responses never become report advice', async () => {
+  process.env.QA_LAYA_URL = 'http://localhost:8000'; process.env.QA_LAYA_API_KEY = 'test-only';
+  globalThis.fetch = async () => new Response(JSON.stringify({ advice: { label: 'PRODUCT_BUG', workflow: 'qa_cause',
+    answer_confidence: .9, review_required: false, advisory_only: true, authorization: false }, runtime: { device: 'cpu' } }));
+  assert.equal(await systemOneAdvice(report, ghostshield), undefined);
+});
+test('credentials and account identifiers are removed', () => {
+  const text = redactSystemOne('user@example.com password=secret bearer abcdefghijklmnopqrstuvwxyz123456789');
+  assert.ok(!text.includes('user@example.com'));
+  assert.ok(!text.includes('password=secret'));
+  assert.ok(!text.includes('abcdefghijklmnopqrstuvwxyz'));
+});
diff --git a/scripts/replay-system-one.ts b/scripts/replay-system-one.ts
new file mode 100644
--- /dev/null
+++ b/scripts/replay-system-one.ts
@@ -0,0 +1,19 @@
+/** Read-only evidence replay: no browser session, account creation, cleanup or notification. */
+import { readFileSync } from 'node:fs';
+import { systemOneAdvice } from '../src/llm/systemOne.js';
+import { ghostshield } from '../src/sites/ghostshield.js';
+import { totalguard } from '../src/sites/totalguard.js';
+import type { RunReport } from '../src/report/model.js';
+
+const paths = process.argv.slice(2);
+if (!paths.length) throw new Error('Pass one or more captured report.json files. Configure QA_LAYA_URL and QA_LAYA_API_KEY for this process.');
+const output = [];
+for (const path of paths) {
+  const report = JSON.parse(readFileSync(path, 'utf8')) as RunReport;
+  if (!['ghostshield', 'totalguard'].includes(report.site) || !Array.isArray(report.tests)) throw new Error('Unsupported report shape');
+  const before = JSON.stringify(report);
+  const hints = await systemOneAdvice(report, report.site === 'ghostshield' ? ghostshield : totalguard);
+  if (JSON.stringify(report) !== before) throw new Error('Shadow replay mutated the source report');
+  output.push({ runId: report.runId, status: report.status, hints: hints ?? [], sourceUnchanged: true });
+}
+console.log(JSON.stringify(output));
